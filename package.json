    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.5.0",
    "meshoptimizer": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
